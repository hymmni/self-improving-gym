#!/bin/sh
# 충돌 표시가 남은 커밋, main 직접 커밋, 규칙에 맞지 않는 브랜치 이름을 막는다.
if git diff --cached -U0 | grep -qE '^\+(<<<<<<<|>>>>>>>)( |$)'; then
  echo "BLOCKED: 충돌 표시(<<<<<<< 또는 >>>>>>>)가 남아 있습니다. 해결한 뒤 커밋하세요." >&2
  exit 1
fi

git rev-parse -q --verify HEAD >/dev/null || exit 0     # 레포의 첫 커밋
branch=$(git symbolic-ref -q --short HEAD) || exit 0    # detached HEAD

if [ "$branch" = main ]; then
  # main_via_pr: false로 설치한 프로젝트는 사람이 로컬에서 main에 병합한다. git은 hook을 저장소 루트에서 실행한다.
  grep -qx 'main_via_pr: false' .copier-answers.yml 2>/dev/null && exit 0
  echo "BLOCKED: main에 직접 커밋하거나 병합할 수 없습니다. 브랜치를 만들어 PR로 합치세요." >&2
  exit 1
fi

if ! printf '%s\n' "$branch" | LC_ALL=C grep -Eq '^(feat|fix|refactor|docs|chore)/[a-z0-9._-]+$'; then
  echo "BLOCKED: 브랜치 이름 '$branch'이(가) 규칙에 맞지 않습니다." >&2
  echo "  형식: feat|fix|refactor|docs|chore/<소문자 주제>" >&2
  exit 1
fi
